<?xml version="1.0" encoding="utf-8"?>
<!-- FIX: ScrollView е вече основният елемент за по-голяма стабилност в редактора. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".SettingsActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Група за Камера -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/cam_settings_title" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Камера IP" />

        <EditText
            android:id="@+id/camIPTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/cam_ip_hint"
            android:inputType="text" />


        <!-- Група за Архив -->
        <TextView
            style="@style/TextAppearance.AppCompat.Title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="@string/archive_settings_title" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Архив IP" />

        <EditText
            android:id="@+id/backupIPTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/archive_ip_hint"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Архив потребител" />

        <EditText
            android:id="@+id/backupUserTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/archive_user_hint"
            android:inputType="text" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Архив парола" />

        <EditText
            android:id="@+id/backupPassTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/archive_pass_hint"
            android:inputType="textPassword" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Архив път" />

        <EditText
            android:id="@+id/backupPathTxt"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/archive_path_hint"
            android:inputType="text" />


        <!-- Група за бутоните -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp">

            <androidx.constraintlayout.helper.widget.Flow
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:constraint_referenced_ids="okButton, clrCount, clrToken, infoButton, stopButton, sleepButton, albumButton, injectButton"
                app:flow_wrapMode="chain"
                app:flow_horizontalStyle="packed"
                app:flow_horizontalBias="0.5"
                app:flow_horizontalGap="8dp"
                app:flow_verticalGap="8dp"
                />

            <Button
                android:id="@+id/okButton"
                style="?attr/materialButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_start" />

            <Button
                android:id="@+id/clrCount"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_stat" />

            <Button
                android:id="@+id/clrToken"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_token" />

            <Button
                android:id="@+id/infoButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_info" />

            <Button
                android:id="@+id/stopButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:strokeColor="@android:color/holo_red_dark"
                android:textColor="@android:color/holo_red_dark"
                android:text="@string/btn_stop" />

            <Button
                android:id="@+id/sleepButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_no_sleep" />

            <Button
                android:id="@+id/albumButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_album" />

            <Button
                android:id="@+id/injectButton"
                style="?attr/materialButtonOutlinedStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/btn_inject" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- Полета за статус -->
        <TextView
            android:id="@+id/statusTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBody1"
            android:visibility="gone"
            tools:text="Статус: В изчакване..."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/lastDownloadResultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Последно изтегляне: SUCCESS"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/totalFilesDownloadedTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBody1"
            android:visibility="gone"
            tools:text="Общо изтеглени файлове: 123"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/lastDownloadDurationTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Време на последно изтегляне: 1.50 сек."
            tools:visibility="visible" />

        <TextView
            android:id="@+id/pendingCameraFilesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@android:color/holo_blue_dark"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Оставащи файлове в камерата: 10"
            tools:visibility="visible" />

        <!-- НОВИ ТЕКСТОВИ ПОЛЕТА ЗА СТАТУС НА КАЧВАНЕТО -->
        <TextView
            android:id="@+id/lastUploadResultTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Последно качване: SUCCESS"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/totalFilesUploadedTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:textStyle="bold"
            android:textAppearance="?attr/textAppearanceBody1"
            android:visibility="gone"
            tools:text="Общо качени файлове: 123"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/pendingSftpFilesTextView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textColor="@android:color/holo_green_dark"
            android:textAppearance="?attr/textAppearanceBody2"
            android:visibility="gone"
            tools:text="Оставащи файлове за качване: 5"
            tools:visibility="visible" />

        <Space
            android:layout_width="match_parent"
            android:layout_height="64dp" />

    </LinearLayout>
</ScrollView>

